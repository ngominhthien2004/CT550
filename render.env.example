# ============================================
# Render Environment Variables
# ============================================
# Set these in Render Dashboard > Environment Groups

# --- Group: ct550 (Backend Web Service) ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/ct550?retryWrites=true&w=majority
JWT_SECRET=your-strong-random-secret-here
NODE_ENV=production
FRONTEND_URL=https://ct550-frontend.onrender.com
CORS_ORIGIN=https://ct550-frontend.onrender.com
# Book service microservice URL (used for API proxy in production)
# Default for local dev: http://localhost:5001
BOOK_SERVICE_URL=https://ct550-bookservice.onrender.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://ct550.onrender.com/api/auth/google/callback

# Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=https://ct550.onrender.com/api/auth/facebook/callback

# Cloudinary (required for image uploads: artwork, avatar, banner, series cover)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_FOLDER=illuwrl-artworks

# Google Vision API (auto-tagging)
GOOGLE_VISION_API_KEY=

# AI Chat — set AI_PROVIDER=openai to use DeepSeek/OpenAI-compatible API
# If omitted, defaults to 'ollama' which does NOT run on Render.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# HuggingFace token (AI detection)
HF_TOKEN=

# GIPHY API key (GIF search)
GIPHY_API_KEY=

# Upload & rate limiting (optional — defaults apply if omitted)
MAX_UPLOAD_FILE_SIZE_MB=10
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_GENERAL_MAX=100
# --- Group: ct550-frontend (Frontend Static Site) ---
VITE_API_BASE_URL=https://ct550.onrender.com/api
# When set, the frontend calls the book-service microservice directly,
# bypassing the main-backend proxy (which can hang on protected POSTs).
# Must match the Render URL of the CT550-BookService web service.
VITE_BOOK_SERVICE_URL=https://ct550-bookservice.onrender.com

# --- Group: ct550-books (Book Service Web Service) ---
# Allow the production frontend to call the book-service directly.
# Comma-separated list. The default is empty in production (CORS_ORIGIN
# falls back to [] when not set, so direct calls would be blocked).
CORS_ORIGIN=https://ct550-frontend.onrender.com
